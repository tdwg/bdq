bdqtest:dc8aae4b-134f-4d75-8a71-c4186239178e a bdqffdq:Validation ;
    rdfs:label "VALIDATION_DATEIDENTIFIED_INRANGE" ;
    dcterms:description "Is the value of dwc:dateIdentified within Parameters range and does it overlap with or is it later than dwc:eventDate?" ;
    dcterms:hasVersion <https://rs.tdwg.org/bdqtest/terms/version/dc8aae4b-134f-4d75-8a71-c4186239178e-2025-03-07> ;
    dcterms:modified "2025-03-07"^^xsd:date ;
    dcterms:references <https://en.wikipedia.org/wiki/ISO_8601>,
        <https://www.iso.org/obp/ui/>,
        <https://www.loc.gov/standards/datetime/> ;
    owl:sameAs <urn:uuid:dc8aae4b-134f-4d75-8a71-c4186239178e> ;
    skos:historyNote "https://github.com/tdwg/bdq/issues/76" ;
    skos:note "There may be valid identifications prior to Linnaeus, but this Test will flag these under the default value of bdqval:earliestValidDate, as for most biodiversity data, pre-Linnaean identification dates are likely to be errors. If a parameter is not set, then the default is 1753-01-01. This Test will, by design, flag as problematic cases (such as LTER plots and marine mammal sightings) where a known individual organism is identified by a specialist and then subsequently observed without new taxonomic identifications being made." ;
    skos:prefLabel "Validation dwc:dateIdentified In Range for SingleRecord" ;
    bdqffdq:hasActedUponInformationElement <https://rs.tdwg.org/bdqtest/informationelement/e4f1fc86-c84d-4e92-9cf2-5250f243b371> ;
    bdqffdq:hasConsultedInformationElement <https://rs.tdwg.org/bdqtest/informationelement/73513536-e916-4290-800a-c2daf8932e28> ;
    bdqffdq:hasCriterion bdqcrit:InRange ;
    bdqffdq:hasDataQualityDimension bdqdim:Likeliness ;
    bdqffdq:hasDateLastUpdated "2024-09-16"^^xsd:date ;
    bdqffdq:hasResourceType bdqffdq:SingleRecord .

bdqtest:eaad41c5-1d46-4917-a08b-4fd1d7ff5c0f a bdqffdq:Validation ;
    rdfs:label "VALIDATION_PHYLUM_FOUND" ;
    dcterms:description "Does the value of dwc:phylum occur at the rank of Phylum in the bdqval:sourceAuthority?" ;
    dcterms:hasVersion <https://rs.tdwg.org/bdqtest/terms/version/eaad41c5-1d46-4917-a08b-4fd1d7ff5c0f-2025-03-06> ;
    dcterms:modified "2025-03-06"^^xsd:date ;
    dcterms:references <https://doi.org/10.15468/39omei> ;
    owl:sameAs <urn:uuid:eaad41c5-1d46-4917-a08b-4fd1d7ff5c0f> ;
    skos:historyNote "https://github.com/tdwg/bdq/issues/22" ;
    skos:note "The purpose of this Test is to check whether the value is a name that is a result of a nomenclatural act at this rank. This excludes unpublished names, misspellings and vernacular names. It is expected that the Test will designate the source authority against which to check. The same Test might return distinct results when using distinct source authorities.  **Review Note: GBIF has indicated that we should switch to the Catalog of Life for the default source authority for this test. That change is planned prior to ratification.**" ;
    skos:prefLabel "Validation dwc:phylum Found for SingleRecord" ;
    bdqffdq:hasActedUponInformationElement <https://rs.tdwg.org/bdqtest/informationelement/8fe0d938-7aa4-40a2-87b7-5bd7e9727e95> ;
    bdqffdq:hasCriterion bdqcrit:Found ;
    bdqffdq:hasDataQualityDimension bdqdim:Conformance ;
    bdqffdq:hasDateLastUpdated "2022-03-25"^^xsd:date ;
    bdqffdq:hasResourceType bdqffdq:SingleRecord .

