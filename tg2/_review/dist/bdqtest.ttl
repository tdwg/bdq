bdqtest:6eeac3ed-f691-457f-a42e-eaa9c8a71ce8 a bdqffdq:Validation ;
    rdfs:label "VALIDATION_SCIENTIFICNAMEID_COMPLETE" ;
    dcterms:description "Does the value of dwc:scientificNameID contain a complete identifier?" ;
    dcterms:hasVersion <https://rs.tdwg.org/bdqtest/terms/version/6eeac3ed-f691-457f-a42e-eaa9c8a71ce8-2025-03-06> ;
    dcterms:modified "2025-03-06"^^xsd:date ;
    dcterms:references <https://doi.org/10.15468/39omei>,
        <https://en.wikipedia.org/wiki/LSID> ;
    owl:sameAs <urn:uuid:6eeac3ed-f691-457f-a42e-eaa9c8a71ce8> ;
    skos:historyNote "https://github.com/tdwg/bdq/issues/212" ;
    skos:note "If any single bdqval:sourceAuthority such as GBIF is used, a valid and complete dwc:scientificNameID based on an alternative source authority is unlikely to provide a valid match. A text or number string as a namespace indicator without a URI will be ambiguous. As an example, GBIF's backbone taxonomy dataset can be found at https://doi.org/10.15468/39omei. When referencing a GBIF taxon by GBIF's identifier for that taxon, use the the pseudo-namespace \"gbif:\" and the form \"gbif:{integer}\" as the value for dwc:scientificNameID. Note that GBIF currently uses \"TaxonID\" for this entity. The terms NID, NSS, and URN are all Uniform Resource Identifiers - see the Wikipedia (2024) reference.  **Review Note: GBIF has indicated that we should switch to the Catalog of Life for the default source authority for this test. That change is planned prior to ratification.**" ;
    skos:prefLabel "Validation dwc:scientificNameID Complete for SingleRecord" ;
    bdqffdq:hasActedUponInformationElement <https://rs.tdwg.org/bdqtest/informationelement/92a6c199-f1d7-493e-b643-57d09c5131dd> ;
    bdqffdq:hasCriterion bdqcrit:Complete ;
    bdqffdq:hasDataQualityDimension bdqdim:Completeness ;
    bdqffdq:hasDateLastUpdated "2023-09-18"^^xsd:date ;
    bdqffdq:hasResourceType bdqffdq:SingleRecord .

