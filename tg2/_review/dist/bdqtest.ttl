bdqtest:3136236e-04b6-49ea-8b34-a65f25e3aba1 a bdqffdq:Validation ;
    rdfs:label "VALIDATION_LICENSE_STANDARD" ;
    dcterms:description "Does the value of dcterms:license occur in bdqval:sourceAuthority?" ;
    dcterms:hasVersion <https://rs.tdwg.org/bdqtest/terms/version/3136236e-04b6-49ea-8b34-a65f25e3aba1-2025-03-07> ;
    dcterms:modified "2025-03-07"^^xsd:date ;
    dcterms:references <https://creativecommons.org/licenses/>,
        <https://www.dublincore.org/specifications/dublin-core/dcmi-terms/terms/LicenseDocument/> ;
    owl:sameAs <urn:uuid:3136236e-04b6-49ea-8b34-a65f25e3aba1> ;
    skos:historyNote "https://github.com/tdwg/bdq/issues/38" ;
    skos:note "The license at the record level might be derived from the license of the dataset from which the record is retrieved. This Test must return NOT_COMPLIANT if there is leading or trailing whitespace or there are leading or trailing non-printing characters. The canonical form of the Creative Commons license IRI has nothing after the version (e.g., https://creativecommons.org/licenses/by/4.0/), but may be followed by deed or legalcode e.g. https://creativecommons.org/licenses/by/4.0/deed and this may be followed by a language code. However, only some two-letter language codes have translations, and some translations are identified by a longer string than the two-letter language code. Errors in the language code, or specifying a language code for which a translation doesn't exist returns a 404 error instead of redirecting to the more general license IRI. As of 2024-02-28 deed.mi doesn't exist yet, but legalcode.mi does." ;
    skos:prefLabel "Validation dcterms:license Standard for SingleRecord" ;
    bdqffdq:hasActedUponInformationElement <https://rs.tdwg.org/bdqtest/informationelement/d3daaab7-b042-4dc7-a92f-77f19988f351> ;
    bdqffdq:hasCriterion bdqcrit:Standard ;
    bdqffdq:hasDataQualityDimension bdqdim:Conformance ;
    bdqffdq:hasDateLastUpdated "2024-03-21"^^xsd:date ;
    bdqffdq:hasResourceType bdqffdq:SingleRecord .

bdqtest:3667556d-d8f5-454c-922b-af8af38f613c a bdqffdq:Validation ;
    rdfs:label "VALIDATION_FAMILY_FOUND" ;
    dcterms:description "Does the value of dwc:family occur at the rank of Family in the bdqval:sourceAuthority?" ;
    dcterms:hasVersion <https://rs.tdwg.org/bdqtest/terms/version/3667556d-d8f5-454c-922b-af8af38f613c-2025-03-06> ;
    dcterms:modified "2025-03-06"^^xsd:date ;
    dcterms:references <https://doi.org/10.15468/39omei> ;
    owl:sameAs <urn:uuid:3667556d-d8f5-454c-922b-af8af38f613c> ;
    skos:historyNote "https://github.com/tdwg/bdq/issues/28" ;
    skos:note "The purpose of this Test is to check whether the value is a name that is a result of a nomenclatural act at this rank. This excludes unpublished names, misspellings and vernacular names. It is expected that the Test will designate the source authority against which to check. The same Test might return distinct results when using distinct source authorities. **Review Note: GBIF has indicated that we should switch to the Catalog of Life for the default source authority for this test. That change is planned prior to ratification.**" ;
    skos:prefLabel "Validation dwc:family Found for SingleRecord" ;
    bdqffdq:hasActedUponInformationElement <https://rs.tdwg.org/bdqtest/informationelement/c3987992-230d-4c2e-816c-5b72d98218eb> ;
    bdqffdq:hasCriterion bdqcrit:Found ;
    bdqffdq:hasDataQualityDimension bdqdim:Conformance ;
    bdqffdq:hasDateLastUpdated "2023-09-17"^^xsd:date ;
    bdqffdq:hasResourceType bdqffdq:SingleRecord .

