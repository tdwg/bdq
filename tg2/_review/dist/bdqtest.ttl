bdqtest:fecaa8a3-bbd8-4c5a-a424-13c37c4bb7b1 a bdqffdq:Issue ;
    rdfs:label "ISSUE_ANNOTATION_NOTEMPTY" ;
    dcterms:description "Are there any annotations associated with the record?" ;
    dcterms:hasVersion <https://rs.tdwg.org/bdqtest/terms/version/fecaa8a3-bbd8-4c5a-a424-13c37c4bb7b1-2026-11-16> ;
    dcterms:modified "2026-11-16"^^xsd:date ;
    dcterms:references <urn:uuid:3c0146df-5ce2-4f35-a066-5cf14de8c79a>,
        <urn:uuid:71c9c3d1-fb9d-4774-8f31-63bc7a4ef49b>,
        <urn:uuid:e9d0f3c8-848c-409e-9af3-70425650a575> ;
    owl:sameAs <urn:uuid:fecaa8a3-bbd8-4c5a-a424-13c37c4bb7b1> ;
    skos:historyNote "https://github.com/tdwg/bdq/issues/29" ;
    skos:note "While there is a W3C standard on 'web annotation', there is no TDWG recommendation on how this standard could be applied to annotating Darwin Core records. While implementation of this Test is currently problematic, TG2 considers annotations attached to any aspect of a Darwin Core record justifies this Test as a placeholder in the hope of future developments. The Test queries the bdqval:annotationSystem; the execution framework supplies oa:hasTarget, an IRI identifying the bdqffdq:SingleRecord under evaluation (for example dwc:occurrenceID when it is an IRI, or the IRI of the record in its data source), that is, the IRI that annotations on the record would have as their oa:hasTarget. The value of bdqval:annotationSystem identifies an annotation system that can be queried, for example the IRI of a W3C Web Annotation Protocol container or of a published oa:AnnotationCollection {[https://www.w3.org/TR/annotation-protocol/]}. The default, \"W3C Web Annotation\", names the data model, not a system that can be queried, so with the default the Response.status is EXTERNAL_PREREQUISITES_NOT_MET unless the implementation is configured with an annotation system. The Test validation data use a static oa:AnnotationCollection, https://bdq.tdwg.org/draft/docs/guide/implementers/annotation_test_fixture.jsonld, as the bdqval:annotationSystem." ;
    skos:prefLabel "Issue Annotation Not Empty for SingleRecord" ;
    bdqffdq:hasConsultedInformationElement <https://rs.tdwg.org/bdqtest/informationelement/b7a02234-c4d0-40fd-a437-af8330cc700f> ;
    bdqffdq:hasCriterion bdqcrit:NotEmpty ;
    bdqffdq:hasDataQualityDimension bdqdim:Reliability ;
    bdqffdq:hasDateLastUpdated "2026-11-16"^^xsd:date ;
    bdqffdq:hasResourceType bdqffdq:SingleRecord .

