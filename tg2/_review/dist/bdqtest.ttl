bdqtest:7e0c0418-fe16-4a39-98bd-80e19d95b9d1 a bdqffdq:Validation ;
    rdfs:label "VALIDATION_GEODETICDATUM_STANDARD" ;
    dcterms:description "Does the value of dwc:geodeticDatum occur as a valid geographic CRS, geodetic Datum or ellipsoid in bdqval:sourceAuthority?" ;
    dcterms:hasVersion <https://rs.tdwg.org/bdqtest/terms/version/7e0c0418-fe16-4a39-98bd-80e19d95b9d1-2025-03-07> ;
    dcterms:modified "2025-03-07"^^xsd:date ;
    dcterms:references <https://doi.org/10.15468/doc-gg7h-s853>,
        <https://epsg.io/>,
        <https://epsg.org/>,
        <https://epsg.org/about.html>,
        <https://georeferencing.org/calculator/>,
        <https://spatialreference.org/> ;
    owl:sameAs <urn:uuid:7e0c0418-fe16-4a39-98bd-80e19d95b9d1> ;
    skos:historyNote "https://github.com/tdwg/bdq/issues/59" ;
    skos:note "Darwin Core recommends best practice is to use a controlled vocabulary. This Test must return NOT_COMPLIANT if there is leading or trailing whitespace or there are leading or trailing non-printing characters. Chapman and Wieczorek (2020) recommend best practice is to use EPSG geographic CRS or Datum codes (https://epsg.io/) as a controlled vocabulary. Ideally, amend to the EPSG code for the geographic coordinate reference system (CRS), if known. Otherwise use the EPSG code for the geodetic datum, if known. Otherwise use the EPSG code of the ellipsoid, if known. If none of these is known, use the explicit value \"not recorded\". While \"not recorded\" is not a valid EPSG code, it is a valid value according to Darwin Core. The reference vocabularies of values for geodetic datums and ellipsoids needs to be made available and should map alternative representations of dwc:geodeticDatum strings to EPSG codes, such as \"WGS84\", \"WGS_84\", \"WGS:84\", \"WGS 84\" all with standard value \"EPSG:4326\"." ;
    skos:prefLabel "Validation dwc:geodeticDatum Standard for SingleRecord" ;
    bdqffdq:hasActedUponInformationElement <https://rs.tdwg.org/bdqtest/informationelement/2d1e1a48-f915-4db5-beba-ae73017f3f8b> ;
    bdqffdq:hasCriterion bdqcrit:Standard ;
    bdqffdq:hasDataQualityDimension bdqdim:Conformance ;
    bdqffdq:hasDateLastUpdated "2025-03-03"^^xsd:date ;
    bdqffdq:hasResourceType bdqffdq:SingleRecord .

bdqtest:81cc974d-43cc-4c0f-a5e0-afa23b455aa3 a bdqffdq:Validation ;
    rdfs:label "VALIDATION_ORDER_FOUND" ;
    dcterms:description "Does the value of dwc:order occur at the rank of Order in bdqval:sourceAuthority?" ;
    dcterms:hasVersion <https://rs.tdwg.org/bdqtest/terms/version/81cc974d-43cc-4c0f-a5e0-afa23b455aa3-2025-03-06> ;
    dcterms:modified "2025-03-06"^^xsd:date ;
    dcterms:references <https://doi.org/10.15468/39omei> ;
    owl:sameAs <urn:uuid:81cc974d-43cc-4c0f-a5e0-afa23b455aa3> ;
    skos:historyNote "https://github.com/tdwg/bdq/issues/83" ;
    skos:note "The purpose of this Test is to check whether the value is a name that is a result of a nomenclatural act at this rank. This excludes unpublished names, misspellings and vernacular names. It is expected that the Test will designate the source authority against which to check. The same Test might return distinct results when using distinct source authorities.  **Review Note: GBIF has indicated that we should switch to the Catalog of Life for the default source authority for this test. That change is planned prior to ratification.**" ;
    skos:prefLabel "Validation dwc:order Found for SingleRecord" ;
    bdqffdq:hasActedUponInformationElement <https://rs.tdwg.org/bdqtest/informationelement/b1b7b96f-79c7-414e-998f-4e31c23b6dec> ;
    bdqffdq:hasCriterion bdqcrit:Found ;
    bdqffdq:hasDataQualityDimension bdqdim:Conformance ;
    bdqffdq:hasDateLastUpdated "2023-09-18"^^xsd:date ;
    bdqffdq:hasResourceType bdqffdq:SingleRecord .

