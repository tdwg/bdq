<https://rs.tdwg.org/bdqtest/specification/f799fb5c-37e4-46d7-a07e-87eb071df9c6> a bdqffdq:Specification ;
    rdfs:label "Specification for: VALIDATION_MINELEVATION_LESSTHAN_MAXELEVATION" ;
    dcterms:description "INTERNAL_PREREQUISITES_NOT_MET if dwc:maximumlevationInMeters or dwc:minimumElevationInMeters is bdqval:Empty, or if either is not a number; COMPLIANT if the value of dwc:minimumElevationInMeters is a number less than or equal to the value of the number dwc:maximumElevationInMeters, otherwise NOT_COMPLIANT" ;
    dcterms:hasVersion <https://rs.tdwg.org/bdqtest/specification/version/f799fb5c-37e4-46d7-a07e-87eb071df9c6-2023-09-18> ;
    dcterms:modified "2023-09-18"^^xsd:date ;
    owl:sameAs <urn:uuid:f799fb5c-37e4-46d7-a07e-87eb071df9c6> ;
    skos:example "dwc:minimumElevationInMeters=\"0\", dwc:maximumElevationInMeters=\"0\": Response.status=RUN_HAS_RESULT, Response.result=COMPLIANT, Response.comment=\"dwc:minimumElevationInMeters is equal to dwc: maximumElevationInMeters\"",
        "dwc:minimumElevationInMeters=\"1\", dwc:maximumElevationInMeters=\"0\": Response.status=RUN_HAS_RESULT, Response.result=NOT_COMPLIANT, Response.comment=\"dwc:minimumElevationInMeters is greater than dwc:maximumElevationInMeters\"" ;
    bdqffdq:hasAuthoritiesDefaults "" ;
    bdqffdq:hasExpectedResponse "INTERNAL_PREREQUISITES_NOT_MET if dwc:maximumlevationInMeters or dwc:minimumElevationInMeters is bdqval:Empty, or if either is not a number; COMPLIANT if the value of dwc:minimumElevationInMeters is a number less than or equal to the value of the number dwc:maximumElevationInMeters, otherwise NOT_COMPLIANT" .

<https://rs.tdwg.org/bdqtest/specification/f8dfc3fc-6580-4518-b2b4-595c29e9042e> a bdqffdq:Specification ;
    rdfs:label "Specification for: VALIDATION_COORDINATEUNCERTAINTY_INRANGE" ;
    dcterms:description "INTERNAL_PREREQUISITES_NOT_MET if dwc:coordinateUncertaintyInMeters is bdqval:Empty; COMPLIANT if the value of dwc:coordinateUncertaintyInMeters is interpreted as a number between 1 and 20037509 inclusive; otherwise NOT_COMPLIANT" ;
    dcterms:hasVersion <https://rs.tdwg.org/bdqtest/specification/version/f8dfc3fc-6580-4518-b2b4-595c29e9042e-2023-09-18> ;
    dcterms:modified "2023-09-18"^^xsd:date ;
    owl:sameAs <urn:uuid:f8dfc3fc-6580-4518-b2b4-595c29e9042e> ;
    skos:example "dwc:coordinateUncertaintyInMeters=\"-1\": Response.status=RUN_HAS_RESULT, Response.result=NOT_COMPLIANT, Response.comment=\"dwc:coordinateUncertaintyInMeters is out of range\"",
        "dwc:coordinateUncertaintyInMeters=\"1\": Response.status=RUN_HAS_RESULT, Response.result=COMPLIANT, Response.comment=\"dwc:coordinateUncertaintyInMeters is in range\"" ;
    bdqffdq:hasAuthoritiesDefaults "" ;
    bdqffdq:hasExpectedResponse "INTERNAL_PREREQUISITES_NOT_MET if dwc:coordinateUncertaintyInMeters is bdqval:Empty; COMPLIANT if the value of dwc:coordinateUncertaintyInMeters is interpreted as a number between 1 and 20037509 inclusive; otherwise NOT_COMPLIANT" .

<https://rs.tdwg.org/bdqtest/specification/f9471802-a5f7-4f4e-9810-f3f4f43dad1a> a bdqffdq:Specification ;
    rdfs:label "Specification for: VALIDATION_MAXELEVATION_INRANGE" ;
    dcterms:description "INTERNAL_PREREQUISITES_NOT_MET if dwc:maximumElevationInMeters is bdqval:Empty or the value cannot be interpreted as a number; COMPLIANT if the value of dwc:maximumElevationInMeters is within the range of bdqval:minimumValidElevationInMeters to bdqval:maximumValidElevationInMeters inclusive; otherwise NOT_COMPLIANT bdqval:minimumValidElevationInMeters default = \"-430\",bdqval:maximumValidElevationInMeters default = \"8850\"" ;
    dcterms:hasVersion <https://rs.tdwg.org/bdqtest/specification/version/f9471802-a5f7-4f4e-9810-f3f4f43dad1a-2023-09-18> ;
    dcterms:modified "2023-09-18"^^xsd:date ;
    owl:sameAs <urn:uuid:f9471802-a5f7-4f4e-9810-f3f4f43dad1a> ;
    skos:example "dwc:maximumElevationInMeters=\"-500\": Response.status=RUN_HAS_RESULT, Response.result=NOT_COMPLIANT, Response.comment=\"dwc:maximumElevation is not in range, i.e. is <-430\"",
        "dwc:maximumElevationInMeters=\"0\": Response.status=RUN_HAS_RESULT, Response.result=COMPLIANT, Response.comment=\"dwc:maximumElevation is in is range\"" ;
    bdqffdq:hasArgument <https://rs.tdwg.org/bdqtest/argument/1766715d-e588-4361-8b27-1c9cc43662ab>,
        <https://rs.tdwg.org/bdqtest/argument/3ab181c2-a3d8-4317-af4d-f88181e2773a> ;
    bdqffdq:hasAuthoritiesDefaults "bdqval:minimumValidElevationInMeters default = \"-430\",bdqval:maximumValidElevationInMeters default = \"8850\"" ;
    bdqffdq:hasExpectedResponse "INTERNAL_PREREQUISITES_NOT_MET if dwc:maximumElevationInMeters is bdqval:Empty or the value cannot be interpreted as a number; COMPLIANT if the value of dwc:maximumElevationInMeters is within the range of bdqval:minimumValidElevationInMeters to bdqval:maximumValidElevationInMeters inclusive; otherwise NOT_COMPLIANT" .

<https://rs.tdwg.org/bdqtest/specification/fa4e531e-f45e-4dea-8c4b-27d364117808> a bdqffdq:Specification ;
    rdfs:label "Specification for: AMENDMENT_ESTABLISHMENTMEANS_STANDARDIZED" ;
    dcterms:description "EXTERNAL_PREREQUISITES_NOT_MET if the bdqval:sourceAuthority is not available; INTERNAL PREREQUISITES_NOT_MET if dwc:establishmentMeans is bdqval:Empty; AMENDED the value of dwc:establishmentMeans if it can be unambiguously matched to a term in the bdqval:sourceAuthority; otherwise NOT_AMENDED bdqval:sourceAuthority default = \"Establishment Means Controlled Vocabulary List of Terms\" {[https://dwc.tdwg.org/em/]} {GBIF vocabulary API [https://api.gbif.org/v1/vocabularies/EstablishmentMeans/concepts]}" ;
    dcterms:hasVersion <https://rs.tdwg.org/bdqtest/specification/version/fa4e531e-f45e-4dea-8c4b-27d364117808-2024-02-08> ;
    dcterms:modified "2024-02-08"^^xsd:date ;
    owl:sameAs <urn:uuid:fa4e531e-f45e-4dea-8c4b-27d364117808> ;
    skos:example "dwc:establishmentMeans=\"cultivated\": Response.status=NOT_AMENDED, Response.result=\"\", Response.comment=\"dwc:establishmentMeans is not an interpretable value in the bdqval:sourceAuthority\"",
        "dwc:establishmentMeans=\"vag.\": Response.status=AMENDED, Response.result=dwc:establishmentMeans=\"vagrant\", Response.comment=\"dwc:establishmentMeans contains an interpretable value in the bdqval:sourceAuthority\"" ;
    bdqffdq:hasArgument <https://rs.tdwg.org/bdqtest/argument/17d785ee-6ac9-4ab4-9806-f4a2b0d8bbf1> ;
    bdqffdq:hasAuthoritiesDefaults "bdqval:sourceAuthority default = \"Establishment Means Controlled Vocabulary List of Terms\" {[https://dwc.tdwg.org/em/]} {GBIF vocabulary API [https://api.gbif.org/v1/vocabularies/EstablishmentMeans/concepts]}" ;
    bdqffdq:hasExpectedResponse "EXTERNAL_PREREQUISITES_NOT_MET if the bdqval:sourceAuthority is not available; INTERNAL PREREQUISITES_NOT_MET if dwc:establishmentMeans is bdqval:Empty; AMENDED the value of dwc:establishmentMeans if it can be unambiguously matched to a term in the bdqval:sourceAuthority; otherwise NOT_AMENDED" .

<https://rs.tdwg.org/bdqtest/specification/fae50773-a832-4e44-87fe-d66a1332c3e7> a bdqffdq:Specification ;
    rdfs:label "Specification for: AMENDMENT_OCCURRENCESTATUS_STANDARDIZED" ;
    dcterms:description "EXTERNAL_PREREQUISITES_NOT_MET if the bdqval:sourceAuthority is not available; INTERNAL_PREREQUISITES_NOT_MET if dwc:ocurrenceStatus is bdqval:Empty; AMENDED the value of dwc:occurrenceStatus if it can be unambiguously interpreted as a value in the bdqval:sourceAuthority; otherwise NOT_AMENDED bdqval:sourceAuthority default = \"Regex present/absent\" {[\"^(present|absent)$\"]}" ;
    dcterms:hasVersion <https://rs.tdwg.org/bdqtest/specification/version/fae50773-a832-4e44-87fe-d66a1332c3e7-2025-03-03> ;
    dcterms:modified "2025-03-03"^^xsd:date ;
    owl:sameAs <urn:uuid:fae50773-a832-4e44-87fe-d66a1332c3e7> ;
    skos:example "dwc:occurrenceStatus=\"1\": Response.status=AMENDED, Response.result=dwc:occurrenceStatus=\"present\", Response.comment=\"Input field contains an interpretable value. \"",
        "dwc:occurrenceStatus=\"X\": Response.status=NOT_AMENDED, Response.result=, Response.comment=\"Input field contains uninterpretable value \"X\"" ;
    bdqffdq:hasArgument <https://rs.tdwg.org/bdqtest/argument/59635d6c-f265-45dd-8814-b80a1dc41540> ;
    bdqffdq:hasAuthoritiesDefaults "bdqval:sourceAuthority default = \"Regex present/absent\" {[\"^(present|absent)$\"]}" ;
    bdqffdq:hasExpectedResponse "EXTERNAL_PREREQUISITES_NOT_MET if the bdqval:sourceAuthority is not available; INTERNAL_PREREQUISITES_NOT_MET if dwc:ocurrenceStatus is bdqval:Empty; AMENDED the value of dwc:occurrenceStatus if it can be unambiguously interpreted as a value in the bdqval:sourceAuthority; otherwise NOT_AMENDED" .

<https://rs.tdwg.org/bdqtest/specification/fbe854d4-acf3-4c79-a654-81441fed644f> a bdqffdq:Specification ;
    rdfs:label "Specification for: VALIDATION_OCCURRENCESTATUS_STANDARD" ;
    dcterms:description "EXTERNAL_PREREQUISITES_NOT_MET if the bdqval:sourceAuthority is not available; INTERNAL_PREREQUISITES_NOT_MET if dwc:occurrenceStatus is bdqval:Empty; COMPLIANT if the value of dwc:occurrenceStatus is resolved in the bdqval:sourceAuthority; otherwise NOT_COMPLIANT bdqval:sourceAuthority default = \"Regex present/absent\" {[\"^(present|absent)$\"]}" ;
    dcterms:hasVersion <https://rs.tdwg.org/bdqtest/specification/version/fbe854d4-acf3-4c79-a654-81441fed644f-2025-02-18> ;
    dcterms:modified "2025-02-18"^^xsd:date ;
    owl:sameAs <urn:uuid:fbe854d4-acf3-4c79-a654-81441fed644f> ;
    skos:example "dwc:occurrenceStatus=\"presence\": Response.status=RUN_HAS_RESULT, Response.result=NOT_COMPLIANT, Response.comment=\"dwc:occurrenceStatus does not match a term in the bdqval:sourceAuthority\"",
        "dwc:occurrenceStatus=\"present\": Response.status=RUN_HAS_RESULT, Response.result=COMPLIANT, Response.comment=\"dwc:occurrenceStatus matches a term in the bdqval:sourceAuthority\"" ;
    bdqffdq:hasArgument <https://rs.tdwg.org/bdqtest/argument/74716bc2-c82e-49f3-938b-2298094554b4> ;
    bdqffdq:hasAuthoritiesDefaults "bdqval:sourceAuthority default = \"Regex present/absent\" {[\"^(present|absent)$\"]}" ;
    bdqffdq:hasExpectedResponse "EXTERNAL_PREREQUISITES_NOT_MET if the bdqval:sourceAuthority is not available; INTERNAL_PREREQUISITES_NOT_MET if dwc:occurrenceStatus is bdqval:Empty; COMPLIANT if the value of dwc:occurrenceStatus is resolved in the bdqval:sourceAuthority; otherwise NOT_COMPLIANT" .

