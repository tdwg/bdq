<https://rs.tdwg.org/bdqtest/specification/80c8f69b-4ad3-40ee-bccd-de016bfae367> a bdqffdq:Specification ;
    rdfs:label "Specification for: VALIDATION_EVENTDATE_STANDARD" ;
    dcterms:description "INTERNAL_PREREQUISITES_NOT_MET if dwc:eventDate is bdqval:Empty; COMPLIANT if the value of dwc:eventDate is a valid ISO 8601 date; otherwise NOT_COMPLIANT" ;
    dcterms:hasVersion <https://rs.tdwg.org/bdqtest/specification/version/80c8f69b-4ad3-40ee-bccd-de016bfae367-2024-09-16> ;
    dcterms:modified "2024-09-16"^^xsd:date ;
    owl:sameAs <urn:uuid:80c8f69b-4ad3-40ee-bccd-de016bfae367> ;
    skos:example "dwc:eventDate=\"1963-03-08T14\": Response.status=RUN_HAS_RESULT, Response.result=COMPLIANT, Response.comment=\"dwc:eventDate contains a valid ISO 8601-1:2019 date\"",
        "dwc:eventDate=\"1963-03-08T14:67-0600\": Response.status=RUN_HAS_RESULT, Response.result=NOT_COMPLIANT, Response.comment=\"dwc:eventDate does not contain a valid ISO 8601-1:2019 date\"" ;
    bdqffdq:hasAuthoritiesDefaults "" ;
    bdqffdq:hasExpectedResponse "INTERNAL_PREREQUISITES_NOT_MET if dwc:eventDate is bdqval:Empty; COMPLIANT if the value of dwc:eventDate is a valid ISO 8601 date; otherwise NOT_COMPLIANT" .

<https://rs.tdwg.org/bdqtest/specification/825f551a-2adf-4509-9f95-5a42601a8e88> a bdqffdq:Specification ;
    rdfs:label "Specification for: AMENDMENT_LICENSE_STANDARDIZED" ;
    dcterms:description "EXTERNAL_PREREQUISITES_NOT_MET if the bdqval:sourceAuthority is not available; AMENDED value of dcterms:license if it could be unambiguously interpreted as a value in the bdqval:sourceAuthority; otherwise NOT_AMENDED. bdqval:sourceAuthority default = \"Creative Commons\" {[https://creativecommons.org/]} {Creative Commons licenses [https://creativecommons.org/about/cclicenses/]}" ;
    dcterms:hasVersion <https://rs.tdwg.org/bdqtest/specification/version/825f551a-2adf-4509-9f95-5a42601a8e88-2023-09-18> ;
    dcterms:modified "2023-09-18"^^xsd:date ;
    owl:sameAs <urn:uuid:825f551a-2adf-4509-9f95-5a42601a8e88> ;
    skos:example "dcterms:license=\"CC0\": Response.status=AMENDED, Response.result=dcterms:license=\"https://creativecommons.org/publicdomain/zero/1.0/legalcode\", Response.comment=\"Input field contains interpretable value\"",
        "dcterms:license=\"X\": Response.status=NOT_AMENDED, Response.result=\"\", Response.comment=\"dcterms:license contains uninterpretable value \"X\"\"" ;
    bdqffdq:hasArgument <https://rs.tdwg.org/bdqtest/argument/7ecc692d-e65f-4ea5-9d54-04421ec96ab4> ;
    bdqffdq:hasAuthoritiesDefaults "bdqval:sourceAuthority default = \"Creative Commons\" {[https://creativecommons.org/]} {Creative Commons licenses [https://creativecommons.org/about/cclicenses/]}" ;
    bdqffdq:hasExpectedResponse "EXTERNAL_PREREQUISITES_NOT_MET if the bdqval:sourceAuthority is not available; AMENDED value of dcterms:license if it could be unambiguously interpreted as a value in the bdqval:sourceAuthority; otherwise NOT_AMENDED." .

