bdqtest:3cff4dc4-72e9-4abe-9bf3-8a30f1618432 a bdqffdq:Validation ;
    rdfs:label "VALIDATION_EVENTDATE_INRANGE" ;
    dcterms:description "Is the value of dwc:eventDate entirely with the Parameter range?" ;
    dcterms:hasVersion <https://rs.tdwg.org/bdqtest/terms/version/3cff4dc4-72e9-4abe-9bf3-8a30f1618432-2025-03-06> ;
    dcterms:modified "2025-03-06"^^xsd:date ;
    dcterms:references <https://en.wikipedia.org/wiki/ISO_8601>,
        <https://www.iso.org/obp/ui/>,
        <https://www.loc.gov/standards/datetime/> ;
    owl:sameAs <urn:uuid:3cff4dc4-72e9-4abe-9bf3-8a30f1618432> ;
    skos:historyNote "https://github.com/tdwg/bdq/issues/36" ;
    skos:note "This Test provides for a default earliest date, which is 1582-11-15 by convention. That date was chosen because ISO 8601-1 asserts that \"the use of proleptic Gregorian calendar dates prior are not allowed in ISO 8601-1 without prior agreement of the parties exchanging data\", and Darwin Core does not comment on this. Different calendars have been used at different times in different places, and the transcription of an original date in one calendar into dwc:eventDate, where a Gregorian Calendar is assumed, may or may not have been done with the correct translation of the date, and metadata may or not be present to even identify such records. Given the complexity, and ongoing nature of transitions between calendars, we do not advocate using this Test for quality assurance by selecting a transition date and using it as a threshold." ;
    skos:prefLabel "Validation dwc:eventDate In Range for SingleRecord" ;
    bdqffdq:hasActedUponInformationElement <https://rs.tdwg.org/bdqtest/informationelement/e8c9ef54-af43-4c20-98a8-a7865cc169ac> ;
    bdqffdq:hasCriterion bdqcrit:InRange ;
    bdqffdq:hasDataQualityDimension bdqdim:Conformance ;
    bdqffdq:hasDateLastUpdated "2024-09-16"^^xsd:date ;
    bdqffdq:hasResourceType bdqffdq:SingleRecord .

bdqtest:3f1db29a-bfa5-40db-9fd1-fde020d81939 a bdqffdq:Validation ;
    rdfs:label "VALIDATION_MAXDEPTH_INRANGE" ;
    dcterms:description "Is the value of dwc:maximumDepthInMeters within the Parameter range?" ;
    dcterms:hasVersion <https://rs.tdwg.org/bdqtest/terms/version/3f1db29a-bfa5-40db-9fd1-fde020d81939-2025-03-07> ;
    dcterms:modified "2025-03-07"^^xsd:date ;
    dcterms:references <https://doi.org/10.15468/doc-gg7h-s853>,
        <https://en.wikipedia.org/wiki/Extreme_points_of_Earth> ;
    owl:sameAs <urn:uuid:3f1db29a-bfa5-40db-9fd1-fde020d81939> ;
    skos:historyNote "https://github.com/tdwg/bdq/issues/187" ;
    skos:note "The Challenger Deep in the Mariana Trench is the deepest known point in Earth's oceans at 10,994 meters below sea level. We have rounded up bdqval:maximumValidDepthInMeters." ;
    skos:prefLabel "Validation dwc:maximumDepthInMeters In Range for SingleRecord" ;
    bdqffdq:hasActedUponInformationElement <https://rs.tdwg.org/bdqtest/informationelement/ced8854b-d1ce-4d71-9b77-e5d67a74c4f9> ;
    bdqffdq:hasCriterion bdqcrit:InRange ;
    bdqffdq:hasDataQualityDimension bdqdim:Conformance ;
    bdqffdq:hasDateLastUpdated "2023-09-18"^^xsd:date ;
    bdqffdq:hasResourceType bdqffdq:SingleRecord .

bdqtest:41267642-60ff-4116-90eb-499fee2cd83f a bdqffdq:Validation ;
    rdfs:label "VALIDATION_EVENTTEMPORAL_NOTEMPTY" ;
    dcterms:description "Is there a value in any of the terms dwc:eventDate, dwc:year, dwc:month, dwc:day, dwc:startDayOfYear, dwc:endDayOfYear, dwc:verbatimEventDate?" ;
    dcterms:hasVersion <https://rs.tdwg.org/bdqtest/terms/version/41267642-60ff-4116-90eb-499fee2cd83f-2025-03-06> ;
    dcterms:modified "2025-03-06"^^xsd:date ;
    owl:sameAs <urn:uuid:41267642-60ff-4116-90eb-499fee2cd83f> ;
    skos:historyNote "https://github.com/tdwg/bdq/issues/88" ;
    skos:note "Only fails if all of the relevant fields of the Darwin Core Event class are bdqval:Empty or do not exist. Relevant Darwin Core fields include dwc:eventDate, dwc:verbatimEventDate, dwc:year, dwc:month, dwc:day, dwc:startDayOfYear, dwc:endDayOfYear. The terms dwc:eventID (if populated may or may not point to temporal information accessible to the user of the data) and dwc:eventTime (which is rare) are not included." ;
    skos:prefLabel "Validation dwc:Event Temporal Not Empty for SingleRecord" ;
    bdqffdq:hasActedUponInformationElement <https://rs.tdwg.org/bdqtest/informationelement/9467c6f2-761f-40fd-b738-530f0fc9b597> ;
    bdqffdq:hasCriterion bdqcrit:NotEmpty ;
    bdqffdq:hasDataQualityDimension bdqdim:Completeness ;
    bdqffdq:hasDateLastUpdated "2023-09-30"^^xsd:date ;
    bdqffdq:hasResourceType bdqffdq:SingleRecord .

bdqtest:453844ae-9df4-439f-8e24-c52498eca84a a bdqffdq:Measure ;
    rdfs:label "MEASURE_VALIDATIONTESTS_NOTCOMPLIANT" ;
    dcterms:description "A count of the distinct VALIDATION Tests run on a record that have Response.result=NOT_COMPLIANT." ;
    dcterms:hasVersion <https://rs.tdwg.org/bdqtest/terms/version/453844ae-9df4-439f-8e24-c52498eca84a-2026-11-12> ;
    dcterms:modified "2026-11-12"^^xsd:date ;
    owl:sameAs <urn:uuid:453844ae-9df4-439f-8e24-c52498eca84a> ;
    skos:historyNote "https://github.com/tdwg/bdq/issues/31" ;
    skos:note "We have three individual measures for pass (MEASURE_VALIDATIONTESTS_COMPLIANT (45fb49eb-4a1b-4b49-876f-15d5034dfc73)), fail (MEASURE_VALIDATIONTESTS_NOTCOMPLIANT (453844ae-9df4-439f-8e24-c52498eca84a)), and PREREQUISITES_NOT_MET (49a94636-a562-4e6b-803c-665c80628a3d). To get the total number of Tests that were attempted, add all three measures. To get the total number of Tests that ran, add NOT_COMPLIANT (fail) and COMPLIANT (pass). If no VALIDATION Tests were run on the record, the result is 0." ;
    skos:prefLabel "Measure Validation Tests Not Compliant for SingleRecord" ;
    bdqffdq:hasActedUponInformationElement <https://rs.tdwg.org/bdqtest/informationelement/cccfdbf6-f3b5-4c1e-a7fa-e059a9c416cd> ;
    bdqffdq:hasDataQualityDimension bdqdim:Reliability ;
    bdqffdq:hasDateLastUpdated "2026-11-12"^^xsd:date ;
    bdqffdq:hasResourceType bdqffdq:SingleRecord .

