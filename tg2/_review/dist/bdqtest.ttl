<https://rs.tdwg.org/bdqtest/specification/f7580626-6b32-499a-ad51-0aa22e3eaa4a> a bdqffdq:Specification ;
    rdfs:label "Specification for: MULTIRECORD_MEASURE_QA_EVENTDATE_STANDARD" ;
