bdqtest:0bb8297d-8f8a-42d2-80c1-558f29efe798 a bdqffdq:Validation ;
    rdfs:label "VALIDATION_MINELEVATION_INRANGE" ;
    dcterms:description "Is the value of dwc:minimumElevationInMeters within the Parameter range?" ;
    dcterms:hasVersion <https://rs.tdwg.org/bdqtest/terms/version/0bb8297d-8f8a-42d2-80c1-558f29efe798-2025-03-07> ;
    dcterms:modified "2025-03-07"^^xsd:date ;
    dcterms:references <https://doi.org/10.15468/doc-gg7h-s853>,
        <https://en.wikipedia.org/wiki/Extreme_points_of_Antarctica>,
        <https://en.wikipedia.org/wiki/List_of_elevation_extremes_by_country_> ;
    owl:sameAs <urn:uuid:0bb8297d-8f8a-42d2-80c1-558f29efe798> ;
    skos:historyNote "https://github.com/tdwg/bdq/issues/39" ;
    skos:note "We have rounded up the Parameter values. We are aware of sub-ice elevations in Antarctica to -3,500m and possible sampling in the atmosphere above the elevation of the top of Mt Everest should fail this Test if captured as elevation rather than as distanceAboveSurfaceInMeters. Elevations below the maximum elevation yet above the local surface will be false positives." ;
    skos:prefLabel "Validation dwc:minimumElevationInMeters In Range for SingleRecord" ;
    bdqffdq:hasActedUponInformationElement <https://rs.tdwg.org/bdqtest/informationelement/af5393af-6a71-4e39-aa70-7609ee10d1d0> ;
    bdqffdq:hasCriterion bdqcrit:InRange ;
    bdqffdq:hasDataQualityDimension bdqdim:Conformance ;
    bdqffdq:hasDateLastUpdated "2023-09-17"^^xsd:date ;
    bdqffdq:hasResourceType bdqffdq:SingleRecord .

bdqtest:125b5493-052d-4a0d-a3e1-ed5bf792689e a bdqffdq:Validation ;
    rdfs:label "VALIDATION_KINGDOM_FOUND" ;
    dcterms:description "Does the value of dwc:kingdom occur at the rank of Kingdom in the bdqval:sourceAuthority?" ;
    dcterms:hasVersion <https://rs.tdwg.org/bdqtest/terms/version/125b5493-052d-4a0d-a3e1-ed5bf792689e-2025-03-06> ;
    dcterms:modified "2025-03-06"^^xsd:date ;
    dcterms:references <https://doi.org/10.15468/39omei> ;
    owl:sameAs <urn:uuid:125b5493-052d-4a0d-a3e1-ed5bf792689e> ;
    skos:historyNote "https://github.com/tdwg/bdq/issues/81" ;
    skos:note "The purpose of this Test is to check whether the value is a name that is a result of a nomenclatural act at this rank. This excludes unpublished names, misspellings and vernacular names. It is expected that the Test will designate the source authority against which to check. The same Test might return distinct results when using distinct source authorities. **Review Note: GBIF has indicated that we should switch to the Catalog of Life for the default source authority for this test. That change is planned prior to ratification.**" ;
    skos:prefLabel "Validation dwc:kingdom Found for SingleRecord" ;
    bdqffdq:hasActedUponInformationElement <https://rs.tdwg.org/bdqtest/informationelement/b856f48c-bf6f-4637-b8de-37d379831801> ;
    bdqffdq:hasCriterion bdqcrit:Found ;
    bdqffdq:hasDataQualityDimension bdqdim:Conformance ;
    bdqffdq:hasDateLastUpdated "2023-09-18"^^xsd:date ;
    bdqffdq:hasResourceType bdqffdq:SingleRecord .

