bdqtest:710fe118-17e1-440f-b428-88ba3f547d6d a bdqffdq:Amendment ;
    rdfs:label "AMENDMENT_EVENT_FROM_EVENTDATE" ;
    dcterms:description "Proposes an amendment to values in any of dwc:year, dwc:month, dwc:day, dwc:startDayOfYear or dwc:endDayOfYear from the content of dwc:eventDate." ;
    dcterms:hasVersion <https://rs.tdwg.org/bdqtest/terms/version/710fe118-17e1-440f-b428-88ba3f547d6d-2025-03-06> ;
    dcterms:modified "2025-03-06"^^xsd:date ;
    dcterms:references <https://en.wikipedia.org/wiki/ISO_8601>,
        <https://www.iso.org/obp/ui/>,
        <https://www.loc.gov/standards/datetime/> ;
    owl:sameAs <urn:uuid:710fe118-17e1-440f-b428-88ba3f547d6d> ;
    skos:historyNote "https://github.com/tdwg/bdq/issues/52" ;
    skos:note "Only fields that are empty will be have changes proposed, and only if dwc:eventDate has a valid ISO 8601-1 date. The dwc:eventDate is the canonical form of the event date (it is the first trusted form). If event date does not contain a range,dwc:startDayOfYear = dwc:endDayOfYear. Time (as compared to date) is not deemed a CORE component. Note, see sequencing Tests section of standards documents, run this amendment after any other amendment that may affect dwc:eventDate" ;
    skos:prefLabel "Amendment dwc:Event from dwc:eventDate for SingleRecord" ;
    bdqffdq:hasActedUponInformationElement <https://rs.tdwg.org/bdqtest/informationelement/d95b6eba-3274-4ad5-bb18-357166a64b12> ;
    bdqffdq:hasConsultedInformationElement <https://rs.tdwg.org/bdqtest/informationelement/73513536-e916-4290-800a-c2daf8932e28> ;
    bdqffdq:hasDataQualityDimension bdqdim:Completeness ;
    bdqffdq:hasDateLastUpdated "2024-09-16"^^xsd:date ;
    bdqffdq:hasEnhancement bdqenh:FilledInFrom ;
    bdqffdq:hasResourceType bdqffdq:SingleRecord .

bdqtest:718dfc3c-cb52-4fca-b8e2-0e722f375da7 a bdqffdq:Amendment ;
    rdfs:label "AMENDMENT_EVENTDATE_STANDARDIZED" ;
    dcterms:description "Proposes an amendment of the value of dwc:eventDate to a valid ISO date." ;
    dcterms:hasVersion <https://rs.tdwg.org/bdqtest/terms/version/718dfc3c-cb52-4fca-b8e2-0e722f375da7-2025-03-06> ;
    dcterms:modified "2025-03-06"^^xsd:date ;
    dcterms:references <https://en.wikipedia.org/wiki/ISO_8601>,
        <https://www.iso.org/obp/ui/>,
        <https://www.loc.gov/standards/datetime/> ;
    owl:sameAs <urn:uuid:718dfc3c-cb52-4fca-b8e2-0e722f375da7> ;
    skos:historyNote "https://github.com/tdwg/bdq/issues/61" ;
    skos:note "The intent of the amended range is to capture the original uncertainty where possible. As in the example, we amend \"1999-11\" instead of \"1999-11-01/1999-11-31\". An AMBIGUOUS response is possible." ;
    skos:prefLabel "Amendment dwc:eventDate Standardized for SingleRecord" ;
    bdqffdq:hasActedUponInformationElement <https://rs.tdwg.org/bdqtest/informationelement/e8c9ef54-af43-4c20-98a8-a7865cc169ac> ;
    bdqffdq:hasDataQualityDimension bdqdim:Conformance ;
    bdqffdq:hasDateLastUpdated "2024-09-16"^^xsd:date ;
    bdqffdq:hasEnhancement bdqenh:Standardized ;
    bdqffdq:hasResourceType bdqffdq:SingleRecord .

