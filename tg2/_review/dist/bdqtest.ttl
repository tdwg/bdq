bdqtest:431467d6-9b4b-48fa-a197-cd5379f5e889 a bdqffdq:Amendment ;
    rdfs:label "AMENDMENT_SCIENTIFICNAMEID_FROM_TAXON" ;
    dcterms:description "Proposes an amendment to the value of dwc:scientificNameID if it can be unambiguously resolved from bdqval:sourceAuthority using the available taxon terms." ;
    dcterms:hasVersion <https://rs.tdwg.org/bdqtest/terms/version/431467d6-9b4b-48fa-a197-cd5379f5e889-2025-03-06> ;
    dcterms:modified "2025-03-06"^^xsd:date ;
    dcterms:references <https://doi.org/10.15468/39omei> ;
    owl:sameAs <urn:uuid:431467d6-9b4b-48fa-a197-cd5379f5e889> ;
    skos:historyNote "https://github.com/tdwg/bdq/issues/57" ;
    skos:note "Return a result with no value and a Result.status of NOT_AMENDED with a Response.comment of ambiguous if the information provided does not resolve to a unique result (e.g. if homonyms exist and there is insufficient information in the provided data, for example using the lowest ranking taxa in conjunction with dwc:dwc:scientificNameAuthorship, to resolve them). When referencing a GBIF taxon by GBIF's identifier for that taxon, use the the pseudo-namespace \"gbif:\" and the form \"gbif:{integer}\" as the value for dwc:scientificNameID. **Review Note: GBIF has indicated that we should switch to the Catalog of Life for the default source authority for this test. That change is planned prior to ratification.**" ;
    skos:prefLabel "Amendment dwc:scientificNameID from dwc:Taxon for SingleRecord" ;
    bdqffdq:hasActedUponInformationElement <https://rs.tdwg.org/bdqtest/informationelement/92a6c199-f1d7-493e-b643-57d09c5131dd> ;
    bdqffdq:hasConsultedInformationElement <https://rs.tdwg.org/bdqtest/informationelement/3d755ac9-e1ff-405e-b076-6a8fbbd5a804> ;
    bdqffdq:hasDataQualityDimension bdqdim:Conformance ;
    bdqffdq:hasDateLastUpdated "2023-09-17"^^xsd:date ;
    bdqffdq:hasEnhancement bdqenh:FilledInFrom ;
    bdqffdq:hasResourceType bdqffdq:SingleRecord .

