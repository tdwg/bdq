<https://rs.tdwg.org/bdqtest/specification/3e076cfa-56ff-4b79-9739-736d062eac5a> a bdqffdq:Specification ;
    rdfs:label "Specification for: AMENDMENT_COUNTRYCODE_STANDARDIZED" ;
    dcterms:description "EXTERNAL_PREREQUISITES_NOT_MET if the bdqval:sourceAuthority is not available; INTERNAL_PREREQUISITES_NOT_MET if the value of dwc:countryCode is bdqval:Empty; AMENDED the value of dwc:countryCode if it can be unambiguously interpreted to a value in the bdqval:sourceAuthority; otherwise NOT_AMENDED bdqval:sourceAuthority default = \"ISO 3166-1-alpha-2\" {[https://www.iso.org/iso-3166-country-codes.html]} {ISO 3166-1-alpha-2 Country Code search [https://www.iso.org/obp/ui/#search]}" ;
    dcterms:hasVersion <https://rs.tdwg.org/bdqtest/specification/version/3e076cfa-56ff-4b79-9739-736d062eac5a-2024-11-09> ;
    dcterms:modified "2024-11-09"^^xsd:date ;
    owl:sameAs <urn:uuid:3e076cfa-56ff-4b79-9739-736d062eac5a> ;
    skos:example "dwc:countryCode=\"Aust.\": Response.status=NOT_AMENDED, Response.result=, Response.comment=\"dwc:countryCode contains an ambiguous value\"",
        "dwc:countryCode=\"Australia\": Response.status=AMENDED, Response.result=dwc:countryCode=\"AU\", Response.comment=\"dwc:countryCode contains an interpretable value\"" ;
    bdqffdq:hasAuthoritiesDefaults "bdqval:sourceAuthority default = \"ISO 3166-1-alpha-2\" {[https://www.iso.org/iso-3166-country-codes.html]} {ISO 3166-1-alpha-2 Country Code search [https://www.iso.org/obp/ui/#search]}" ;
    bdqffdq:hasExpectedResponse "EXTERNAL_PREREQUISITES_NOT_MET if the bdqval:sourceAuthority is not available; INTERNAL_PREREQUISITES_NOT_MET if the value of dwc:countryCode is bdqval:Empty; AMENDED the value of dwc:countryCode if it can be unambiguously interpreted to a value in the bdqval:sourceAuthority; otherwise NOT_AMENDED" .

<https://rs.tdwg.org/bdqtest/specification/3eae7451-19c6-403c-ba36-29f8204d15ff> a bdqffdq:Specification ;
    rdfs:label "Specification for: AMENDMENT_DAY_STANDARDIZED" ;
    dcterms:description "INTERNAL_PREREQUISITES_NOT_MET if dwc:day is bdqval:Empty; AMENDED the value of dwc:day if the value is unambiguously interpreted as an integer between 1 and 31 inclusive; otherwise NOT_AMENDED" ;
    dcterms:hasVersion <https://rs.tdwg.org/bdqtest/specification/version/3eae7451-19c6-403c-ba36-29f8204d15ff-2023-09-18> ;
    dcterms:modified "2023-09-18"^^xsd:date ;
    owl:sameAs <urn:uuid:3eae7451-19c6-403c-ba36-29f8204d15ff> ;
    skos:example "dwc:day=\"23rd\": Response.status=AMENDED, Response.result=dwc:day=\"23\", Response.comment=\"dwc:day is interpretable as \"23\"\"",
        "dwc:day=\"X\": Response.status=NOT_AMENDED, Response.result=\"\", Response.comment=\"dwc:day is ambiguous, either a \"X\", \"No data\" or \"10\"\"" ;
    bdqffdq:hasAuthoritiesDefaults "" ;
    bdqffdq:hasExpectedResponse "INTERNAL_PREREQUISITES_NOT_MET if dwc:day is bdqval:Empty; AMENDED the value of dwc:day if the value is unambiguously interpreted as an integer between 1 and 31 inclusive; otherwise NOT_AMENDED" .

