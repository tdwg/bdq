bdqtest:d708526b-6561-438e-aa1a-82cd80b06396 a bdqffdq:Validation ;
    rdfs:label "VALIDATION_MINELEVATION_LESSTHAN_MAXELEVATION" ;
    dcterms:description "Is the value of dwc:minimumElevationInMeters a number less than or equal to the value of dwc:maximumElevationInMeters?" ;
    dcterms:hasVersion <https://rs.tdwg.org/bdqtest/terms/version/d708526b-6561-438e-aa1a-82cd80b06396-2025-03-07> ;
    dcterms:modified "2025-03-07"^^xsd:date ;
    dcterms:references <https://doi.org/10.15468/doc-gg7h-s853> ;
    owl:sameAs <urn:uuid:d708526b-6561-438e-aa1a-82cd80b06396> ;
    skos:historyNote "https://github.com/tdwg/bdq/issues/108" ;
