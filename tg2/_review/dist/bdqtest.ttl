<https://rs.tdwg.org/bdqtest/specification/b85129f0-28c2-4ede-aff2-5ce3791c6e86> a bdqffdq:Specification ;
    rdfs:label "Specification for: VALIDATION_DCTYPE_STANDARD" ;
    dcterms:description "EXTERNAL_PREREQUISITES_NOT_MET if the bdqval:sourceAuthority is not available; INTERNAL_PREREQUISITES_NOT_MET if the value of dc:type is bdqval:Empty; COMPLIANT if the value of dc:type is a term name in the bdqval:sourceAuthority; otherwise NOT_COMPLIANT DCMI Type Vocabulary\" {[http://purl.org/dc/terms/DCMIType]} {\"DCMI Type Vocabulary List of Terms\" [https://www.dublincore.org/specifications/dublin-core/dcmi-type-vocabulary/2010-10-11/]}" ;
    dcterms:hasVersion <https://rs.tdwg.org/bdqtest/specification/version/b85129f0-28c2-4ede-aff2-5ce3791c6e86-2023-09-18> ;
    dcterms:modified "2023-09-18"^^xsd:date ;
    owl:sameAs <urn:uuid:b85129f0-28c2-4ede-aff2-5ce3791c6e86> ;
    skos:example "dc:type=\"Event\": Response.status=RUN_HAS_RESULT, Response.result=COMPLIANT, Response.comment=\"dc:type matches a term in DCMI Vocabulary\"",
        "dc:type=\"StillerImage\": Response.status=RUN_HAS_RESULT, Response.result=NOT_COMPLIANT, Response.comment=\"dc:type does not match terms in DCMI Vocabulary\"" ;
    bdqffdq:hasAuthoritiesDefaults "DCMI Type Vocabulary\" {[http://purl.org/dc/terms/DCMIType]} {\"DCMI Type Vocabulary List of Terms\" [https://www.dublincore.org/specifications/dublin-core/dcmi-type-vocabulary/2010-10-11/]}" ;
    bdqffdq:hasExpectedResponse "EXTERNAL_PREREQUISITES_NOT_MET if the bdqval:sourceAuthority is not available; INTERNAL_PREREQUISITES_NOT_MET if the value of dc:type is bdqval:Empty; COMPLIANT if the value of dc:type is a term name in the bdqval:sourceAuthority; otherwise NOT_COMPLIANT" .

<https://rs.tdwg.org/bdqtest/specification/ba1fa532-9612-4944-bfd1-8bd39ab47758> a bdqffdq:Specification ;
    rdfs:label "Specification for: AMENDMENT_DEGREEOFESTABLISHMENT_STANDARDIZED" ;
    dcterms:description "EXTERNAL_PREREQUISITES_NOT_MET if the bdqval:sourceAuthority is not available; INTERNAL_PREREQUISITES_NOT_MET if dwc:degreeOfEstablishment is bdqval:Empty; AMENDED the value of dwc:degreeOfEstablishment if it can be unambiguously matched to a term in the bdqval:sourceAuthority; otherwise NOT_AMENDED bdqval:sourceAuthority default = \"Degree of Establishment Controlled Vocabulary List of Terms\" {[https://dwc.tdwg.org/doe/]} {GBIF vocabulary API [https://api.gbif.org/v1/vocabularies/DegreeOfEstablishment/concepts]}" ;
    dcterms:hasVersion <https://rs.tdwg.org/bdqtest/specification/version/ba1fa532-9612-4944-bfd1-8bd39ab47758-2024-04-16> ;
    dcterms:modified "2024-04-16"^^xsd:date ;
    owl:sameAs <urn:uuid:ba1fa532-9612-4944-bfd1-8bd39ab47758> ;
    skos:example "dwc:degreeOfEstablishment=\"capt.\": Response.status=AMENDED, Response.result=dwc:degreeOfEstablishment=\"captive\", Response.comment=\"dwc:degreeOfEstablishment contains an interpretable value in the bdqval:sourceAuthority\"",
        "dwc:degreeOfEstablishment=\"tree\": Response.status=NOT_AMENDED, Response.result=\"\", Response.comment=\"dwc:degreeOfEstablishment does not contain an interpretable value in the bdqval:sourceAuthority\"" ;
    bdqffdq:hasArgument <https://rs.tdwg.org/bdqtest/argument/ff9e9459-d1a5-43a6-ada9-8be41772b711> ;
    bdqffdq:hasAuthoritiesDefaults "bdqval:sourceAuthority default = \"Degree of Establishment Controlled Vocabulary List of Terms\" {[https://dwc.tdwg.org/doe/]} {GBIF vocabulary API [https://api.gbif.org/v1/vocabularies/DegreeOfEstablishment/concepts]}" ;
    bdqffdq:hasExpectedResponse "EXTERNAL_PREREQUISITES_NOT_MET if the bdqval:sourceAuthority is not available; INTERNAL_PREREQUISITES_NOT_MET if dwc:degreeOfEstablishment is bdqval:Empty; AMENDED the value of dwc:degreeOfEstablishment if it can be unambiguously matched to a term in the bdqval:sourceAuthority; otherwise NOT_AMENDED" .

<https://rs.tdwg.org/bdqtest/specification/bda7e8a3-3366-43d5-8a8b-e206101dc90d> a bdqffdq:Specification ;
    rdfs:label "Specification for: AMENDMENT_EVENTDATE_FROM_YEARMONTHDAY" ;
    dcterms:description "INTERNAL _PREREQUISITES_NOT_MET if dwc:eventDate is not EMPTY or dwc:year is EMPTY or is not interpretable as an integer; FILLED_IN the value of dwc:eventDate if an ISO 8601 date was interpreted from the values in dwc:year, dwc:month and dwc:day; otherwise NOT_AMENDED" ;
    dcterms:hasVersion <https://rs.tdwg.org/bdqtest/specification/version/bda7e8a3-3366-43d5-8a8b-e206101dc90d-2024-09-15> ;
    dcterms:modified "2024-09-15"^^xsd:date ;
    owl:sameAs <urn:uuid:bda7e8a3-3366-43d5-8a8b-e206101dc90d> ;
    skos:example "dwc:eventDate=\"\", dwc:year=\"1420\", dwc:month=\"10\", dwc:day=\"29\": Response.status=FILLED_IN, Response.result=dwc:eventDate=\"1420-10-29\", Response.comment=\"dwc:year, dwc:month and dwc:day are interpretable, even if pre-Linnaeus\"",
        "dwc:eventDate=\"\", dwc:year=\"2024\", dwc:month=\"2\", dwc:day=\"30\": Response.status=NOT_AMENDED, Response.result=, Response.comment=\"Not a valid date\"" ;
    bdqffdq:hasAuthoritiesDefaults "" ;
    bdqffdq:hasExpectedResponse "INTERNAL _PREREQUISITES_NOT_MET if dwc:eventDate is not EMPTY or dwc:year is EMPTY or is not interpretable as an integer; FILLED_IN the value of dwc:eventDate if an ISO 8601 date was interpreted from the values in dwc:year, dwc:month and dwc:day; otherwise NOT_AMENDED" .

<https://rs.tdwg.org/bdqtest/specification/be57619a-9c9d-459f-8fb6-02aa912cd696> a bdqffdq:Specification ;
    rdfs:label "Specification for: MULTIRECORD_MEASURE_COUNT_COMPLIANT_CLASS_FOUND" ;
    dcterms:description "Count the number of VALIDATION_CLASS_FOUND in the MultiRecord that have Response.result=COMPLIANT." ;
