    dcterms:references <https://en.wikipedia.org/wiki/ISO_8601>,
        <https://www.iso.org/obp/ui/>,
        <https://www.loc.gov/standards/datetime/> ;
    owl:sameAs <urn:uuid:8d787cb5-73e2-4c39-9cd1-67c7361dc02e> ;
    skos:historyNote "https://github.com/tdwg/bdq/issues/125" ;
    skos:note "This Test must take into account the given month and year, if present, to account for leap years. This is part of a group of similar Tests (VALIDATION_DAY_INRANGE (8d787cb5-73e2-4c39-9cd1-67c7361dc02e, #VALIDATION_STARTDAYOFYEAR_INRANGE (85803c7e-2a5a-42e1-b8d3-299a44cafc46), VALIDATION_ENDDAYOFYEAR_INRANGE9a39d88c-7eee-46df-b32a-c109f9f81fb8))." ;
    skos:prefLabel "Validation dwc:day In Range for SingleRecord" ;
    bdqffdq:hasActedUponInformationElement <https://rs.tdwg.org/bdqtest/informationelement/3b27257d-cfe4-4e47-8352-1bc4bad44ad4> ;
    bdqffdq:hasCriterion bdqcrit:InRange ;
    bdqffdq:hasDataQualityDimension bdqdim:Conformance ;
    bdqffdq:hasDateLastUpdated "2024-09-16"^^xsd:date ;
    bdqffdq:hasResourceType bdqffdq:SingleRecord .

