<https://rs.tdwg.org/bdqtest/specification/1999e4e0-ce3a-46e3-b131-24412bd94bd1> a bdqffdq:Specification ;
    rdfs:label "Specification for: ISSUE_ANNOTATION_NOTEMPTY" ;
    dcterms:description "EXTERNAL_PREREQUISITES_NOT_MET if the bdqval:annotationSystem is not available; INTERNAL_PREREQUISITES_NOT_MET if oa:hasTarget is bdqval:Empty; POTENTIAL_ISSUE if an annotation in the bdqval:annotationSystem exists and has an oa:hasTarget referencing the bdqffdq:SingleRecord under evaluation with matching bdqval:annotationAlertIf criteria; otherwise NOT_ISSUE. bdqval:annotationSystem default = \"W3C Web Annotation\" {[https://www.w3.org/annotation/]} {\"oa:Annotation vocabulary\" [https://www.w3.org/TR/annotation-vocab/]},bdqval:annotationAlertIf default = \"oa:Annotation with oa:hasTarget having as object any dwciri:term instance that is part of the SingleRecord under Test.\" {[https://www.w3.org/TR/annotation-vocab/]}" ;
    dcterms:hasVersion <https://rs.tdwg.org/bdqtest/specification/version/1999e4e0-ce3a-46e3-b131-24412bd94bd1-2026-11-16> ;
    dcterms:modified "2026-11-16"^^xsd:date ;
    owl:sameAs <urn:uuid:1999e4e0-ce3a-46e3-b131-24412bd94bd1> ;
    skos:example "oa:hasTarget=\"https://example.org/bdq/test/occurrence/1\", bdqval:annotationSystem default: Response.status=EXTERNAL_PREREQUISITES_NOT_MET, Response.comment=\"The bdqval:annotationSystem is not available\"",
        "oa:hasTarget=\"https://example.org/bdq/test/occurrence/1\", bdqval:annotationSystem=\"https://bdq.tdwg.org/draft/docs/guide/implementers/annotation_test_fixture.jsonld\": Response.status=RUN_HAS_RESULT, Response.result=POTENTIAL_ISSUE, Response.comment=\"An annotation in the bdqval:annotationSystem has an oa:hasTarget referencing the record\"" ;
    bdqffdq:hasArgument <https://rs.tdwg.org/bdqtest/argument/8c52d108-f9fe-4835-9939-6acc4430c9ee>,
        <https://rs.tdwg.org/bdqtest/argument/de022674-06c8-48cf-86b6-2cd362e24667> ;
    bdqffdq:hasAuthoritiesDefaults "bdqval:annotationSystem default = \"W3C Web Annotation\" {[https://www.w3.org/annotation/]} {\"oa:Annotation vocabulary\" [https://www.w3.org/TR/annotation-vocab/]},bdqval:annotationAlertIf default = \"oa:Annotation with oa:hasTarget having as object any dwciri:term instance that is part of the SingleRecord under Test.\" {[https://www.w3.org/TR/annotation-vocab/]}" ;
    bdqffdq:hasExpectedResponse "EXTERNAL_PREREQUISITES_NOT_MET if the bdqval:annotationSystem is not available; INTERNAL_PREREQUISITES_NOT_MET if oa:hasTarget is bdqval:Empty; POTENTIAL_ISSUE if an annotation in the bdqval:annotationSystem exists and has an oa:hasTarget referencing the bdqffdq:SingleRecord under evaluation with matching bdqval:annotationAlertIf criteria; otherwise NOT_ISSUE." .

<https://rs.tdwg.org/bdqtest/specification/1a504f7f-21a7-49e1-a0dc-f51146957fa4> a bdqffdq:Specification ;
    rdfs:label "Specification for: VALIDATION_DECIMALLONGITUDE_INRANGE" ;
    dcterms:description "INTERNAL_PREREQUISITES_NOT_MET if dwc:decimalLongitude is bdqval:Empty or the value is not a number; COMPLIANT if the value of dwc:decimalLongitude is between -180 and 180 degrees, inclusive; otherwise NOT_COMPLIANT" ;
    dcterms:hasVersion <https://rs.tdwg.org/bdqtest/specification/version/1a504f7f-21a7-49e1-a0dc-f51146957fa4-2023-09-17> ;
    dcterms:modified "2023-09-17"^^xsd:date ;
    owl:sameAs <urn:uuid:1a504f7f-21a7-49e1-a0dc-f51146957fa4> ;
    skos:example "dwc:decimalLongitude=\"0\": Response.status=RUN_HAS_RESULT, Response.result=COMPLIANT, Response.comment=\"dwc:decimalLongitude is in range\"",
        "dwc:decimalLongitude=\"181.0554\": Response.status=RUN_HAS_RESULT, Response.result=NOT_COMPLIANT, Response.comment=\"dwc:decimalLongitude >180\"" ;
    bdqffdq:hasAuthoritiesDefaults "" ;
    bdqffdq:hasExpectedResponse "INTERNAL_PREREQUISITES_NOT_MET if dwc:decimalLongitude is bdqval:Empty or the value is not a number; COMPLIANT if the value of dwc:decimalLongitude is between -180 and 180 degrees, inclusive; otherwise NOT_COMPLIANT" .

<https://rs.tdwg.org/bdqtest/specification/1a7adc4a-58ee-480c-9765-3834ea433bf0> a bdqffdq:Specification ;
    rdfs:label "Specification for: MEASURE_VALIDATIONTESTS_NOTCOMPLIANT" ;
    dcterms:description "RUN_HAS_RESULT with the result being the number of distinct VALIDATION Tests run on the record that have Response.result=NOT_COMPLIANT." ;
    dcterms:hasVersion <https://rs.tdwg.org/bdqtest/specification/version/1a7adc4a-58ee-480c-9765-3834ea433bf0-2026-11-12> ;
    dcterms:modified "2026-11-12"^^xsd:date ;
    owl:sameAs <urn:uuid:1a7adc4a-58ee-480c-9765-3834ea433bf0> ;
    skos:example "[Response.status=RUN_HAS_RESULT, Response.result=\"37\", Response.comment=\"37 VALIDATION Tests had Response.result=NOT_COMPLIANT.\"]" ;
    bdqffdq:hasAuthoritiesDefaults "" ;
    bdqffdq:hasExpectedResponse "RUN_HAS_RESULT with the result being the number of distinct VALIDATION Tests run on the record that have Response.result=NOT_COMPLIANT." .

