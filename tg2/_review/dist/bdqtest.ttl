bdqtest:8d787cb5-73e2-4c39-9cd1-67c7361dc02e a bdqffdq:Validation ;
    rdfs:label "VALIDATION_DAY_INRANGE" ;
    dcterms:description "Is the value of dwc:day interpretable as a valid integer between 1 and 28 inclusive, or is it validly 29, 30 or 31 given the dwc:month and dwc:year?" ;
    dcterms:hasVersion <https://rs.tdwg.org/bdqtest/terms/version/8d787cb5-73e2-4c39-9cd1-67c7361dc02e-2025-03-06> ;
