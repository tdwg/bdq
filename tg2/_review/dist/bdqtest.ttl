<https://rs.tdwg.org/bdqtest/specification/0067fa60-5503-490e-8c94-93fb79cc7da2> a bdqffdq:Specification ;
    rdfs:label "Specification for: VALIDATION_DECIMALLATITUDE_NOTEMPTY" ;
    dcterms:description "COMPLIANT if dwc:decimalLatitude is bdqval:NotEmpty; otherwise NOT_COMPLIANT" ;
    dcterms:hasVersion <https://rs.tdwg.org/bdqtest/specification/version/0067fa60-5503-490e-8c94-93fb79cc7da2-2023-09-18> ;
    dcterms:modified "2023-09-18"^^xsd:date ;
    owl:sameAs <urn:uuid:0067fa60-5503-490e-8c94-93fb79cc7da2> ;
    skos:example "dwc:decimalLatitude=\"\": Response.status=RUN_HAS_RESULT, Response.result=NOT_COMPLIANT, Response.comment=\"dwc:decimalLatitude is bdqval:Empty\"",
        "dwc:decimalLatitude=\"0\": Response.status=RUN_HAS_RESULT, Response.result=COMPLIANT, Response.comment=\"dwc:decimalLatitude is bdqval:NotEmpty\"" ;
    bdqffdq:hasAuthoritiesDefaults "" ;
    bdqffdq:hasExpectedResponse "COMPLIANT if dwc:decimalLatitude is bdqval:NotEmpty; otherwise NOT_COMPLIANT" .

<https://rs.tdwg.org/bdqtest/specification/01b96157-e4a1-4884-95d7-3bcfc5f3c047> a bdqffdq:Specification ;
    rdfs:label "Specification for: VALIDATION_COUNTRYCODE_STANDARD" ;
    dcterms:description "EXTERNAL_PREREQUISITES_NOT_MET if the bdqval:sourceAuthority is not available; INTERNAL_PREREQUISITES_NOT_MET if the dwc:countryCode is bdqval:Empty; COMPLIANT if dwc:countryCode can be unambiguously interpreted as a valid ISO 3166-1-alpha-2 country code in the bdqval:sourceAuthority; otherwise NOT_COMPLIANT bdqval:sourceAuthority default = \"ISO 3166 Country Codes\" {[https://www.iso.org/iso-3166-country-codes.html]} {ISO 3166-1-alpha-2 Country Code search [https://www.iso.org/obp/ui/#search]}" ;
    dcterms:hasVersion <https://rs.tdwg.org/bdqtest/specification/version/01b96157-e4a1-4884-95d7-3bcfc5f3c047-2024-09-19> ;
    dcterms:modified "2024-09-19"^^xsd:date ;
    owl:sameAs <urn:uuid:01b96157-e4a1-4884-95d7-3bcfc5f3c047> ;
    skos:example "dwc:countryCode=\"GL\": Response.status=RUN_HAS_RESULT, Response.result=COMPLIANT, Response.comment=\"dwc:countryCode is a valid ISO (ISO 3166-1-alpha-2 country codes) value\"",
        "dwc:countryCode=\"GRL\": Response.status=RUN_HAS_RESULT, Response.result=NOT_COMPLIANT, Response.comment=\"dwc:countryCode is NOT a valid ISO (ISO 3166-1-alpha-2 country codes) value\"" ;
    bdqffdq:hasAuthoritiesDefaults "bdqval:sourceAuthority default = \"ISO 3166 Country Codes\" {[https://www.iso.org/iso-3166-country-codes.html]} {ISO 3166-1-alpha-2 Country Code search [https://www.iso.org/obp/ui/#search]}" ;
    bdqffdq:hasExpectedResponse "EXTERNAL_PREREQUISITES_NOT_MET if the bdqval:sourceAuthority is not available; INTERNAL_PREREQUISITES_NOT_MET if the dwc:countryCode is bdqval:Empty; COMPLIANT if dwc:countryCode can be unambiguously interpreted as a valid ISO 3166-1-alpha-2 country code in the bdqval:sourceAuthority; otherwise NOT_COMPLIANT" .

<https://rs.tdwg.org/bdqtest/specification/02242018-3e73-4e0a-8d6f-d1db06cf81a3> a bdqffdq:Specification ;
    rdfs:label "Specification for: VALIDATION_SCIENTIFICNAMEID_NOTEMPTY" ;
