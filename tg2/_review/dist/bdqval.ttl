    dcterms:isVersionOf bdqval:annotationSystem ;
    dcterms:issued "2026-11-22"^^xsd:date ;
    tdwgutility:status "recommended"^^xsd:string ;
    rdf:value "annotationSystem" ;
    rdfs:comment "Optionally establishes a system for annotations in a Test with bdqffdq:Parameters, with the default being the W3C Annotations Data Model's \"oa:Annotation\""@en ;
    rdfs:isDefinedBy bdqval: ;
    skos:definition "Optionally establishes a system for annotations in a Test with bdqffdq:Parameters, with the default being the W3C Annotations Data Model's \"oa:Annotation\""@en ;
    skos:inScheme bdqval: ;
    skos:note "<div xmlns=\"http://www.w3.org/1999/xhtml\">Used in Test \"ANNOTATION_ISSUE_NOTEMPTY\" (bdqtest:fecaa8a3-bbd8-4c5a-a424-13c37c4bb7b1).</div>"^^rdf:XMLLiteral ;
    skos:prefLabel "annotationSystem"@en .

<https://rs.tdwg.org/bdqval/terms/version/assumptionOnUnknownBiome-2026-11-22> a owl:NamedIndividual,
