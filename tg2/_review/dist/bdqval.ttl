    rdfs:comment "An Abstract Information Element composed of the bdqffdq:AmendmentResponses of the bdqffdq:Amendment Tests run on a bdqffdq:SingleRecord in a single bdqffdq:DataQualityReport, forming the input to another Test."@en ;
    rdfs:isDefinedBy bdqval: ;
    skos:definition "An Abstract Information Element composed of the bdqffdq:AmendmentResponses of the bdqffdq:Amendment Tests run on a bdqffdq:SingleRecord in a single bdqffdq:DataQualityReport, forming the input to another Test."@en ;
    skos:inScheme bdqval: ;
    skos:note "<div xmlns=\"http://www.w3.org/1999/xhtml\">Used in Measure of Single Record Tests</div>"^^rdf:XMLLiteral ;
    skos:prefLabel "AllAmendmentTestsRunOnSingleRecord"@en .

