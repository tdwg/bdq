    tdwgutility:status "recommended"^^xsd:string ;
    rdf:value "includeEventDate" ;
    rdfs:comment "Allows dwc:eventDate to be excluded in a Test with bdqffdq:Parameters. The default is to include the dwc:eventDate in the Test, but it may be excluded to allow a dwc:dateIdentified to be prior to the dwc:eventDate."@en ;
    rdfs:isDefinedBy bdqval: ;
    skos:definition "Allows dwc:eventDate to be excluded in a Test with bdqffdq:Parameters. The default is to include the dwc:eventDate in the Test, but it may be excluded to allow a dwc:dateIdentified to be prior to the dwc:eventDate."@en ;
    skos:inScheme bdqval: ;
    skos:note "<div xmlns=\"http://www.w3.org/1999/xhtml\">Used in Test \"VALIDATION_DATEIDENTIFIED_INRANGE\" (bdqtest:dc8aae4b-134f-4d75-8a71-c4186239178e).</div>"^^rdf:XMLLiteral ;
