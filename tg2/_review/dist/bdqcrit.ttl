    skos:note "<div xmlns=\"http://www.w3.org/1999/xhtml\">Data in a bdqffdq:InformationElement conform to a format, syntax, data type, or standard. Corresponding dimension is bdqdim:Conformance.</div>"^^rdf:XMLLiteral ;
    skos:prefLabel "Standard"@en .

<https://rs.tdwg.org/bdqcrit/terms/version/Unambiguous-2024-09-30> a bdqffdq:Criterion ;
    rdfs:label "Unambiguous"@en ;
