    tdwgutility:status "recommended"^^xsd:string ;
    rdf:value "InRange" ;
    rdfs:comment "Data conform to an expected range of values."@en ;
    rdfs:isDefinedBy bdqcrit: ;
    skos:definition "Data conform to an expected range of values."@en ;
    skos:inScheme bdqcrit: ;
    skos:note "<div xmlns=\"http://www.w3.org/1999/xhtml\">Data in a bdqffdq:InformationElement conform to an expected range of values. Corresponding dimension is bdqdim:Conformance.</div>"^^rdf:XMLLiteral ;
    skos:prefLabel "In Range"@en .

<https://rs.tdwg.org/bdqcrit/terms/version/Likely-2024-09-30> a bdqffdq:Criterion ;
    rdfs:label "Likely"@en ;
    dcterms:isPartOf bdqcrit: ;
