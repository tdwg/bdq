    skos:note "<div xmlns=\"http://www.w3.org/1999/xhtml\">Data in a bdqffdq:InformationElement adequately identifies a unique entity. Corresponding dimension is bdqdim:Conformance.</div>"^^rdf:XMLLiteral ;
    skos:prefLabel "Unambiguous"@en .

