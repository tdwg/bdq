    skos:inScheme bdqcrit: ;
    skos:note "<div xmlns=\"http://www.w3.org/1999/xhtml\">Data in a bdqffdq:InformationElement is likely to be true or expected values. Corresponding dimension is bdqdim:Likeliness.</div>"^^rdf:XMLLiteral ;
    skos:prefLabel "Likely"@en .

<https://rs.tdwg.org/bdqcrit/terms/version/NotEmpty-2024-09-30> a bdqffdq:Criterion ;
    rdfs:label "Not Empty"@en ;
    dcterms:isPartOf bdqcrit: ;
    dcterms:isVersionOf bdqcrit:NotEmpty ;
    dcterms:issued "2024-09-30"^^xsd:date ;
    tdwgutility:status "recommended"^^xsd:string ;
    rdf:value "NotEmpty" ;
    rdfs:comment "Some data value is present."@en ;
    rdfs:isDefinedBy bdqcrit: ;
    skos:definition "Some data value is present."@en ;
