  {
    "@id": "https://rs.tdwg.org/bdqffdq/terms/NOT_ISSUE",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://rs.tdwg.org/bdqffdq/terms/ResponseResult"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2024-09-30"
      }
    ],
    "http://purl.org/dc/terms/isPartOf": [
      {
        "@id": "https://rs.tdwg.org/bdqffdq/terms/"
      }
    ],
    "http://purl.org/dc/terms/modified": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-11-09"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A bdqffdq:ResponseResult of a bdqffdq:Issue where no potential problems were detected."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://rs.tdwg.org/bdqffdq/terms/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "NOT_ISSUE"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A bdqffdq:ResponseResult of a bdqffdq:Issue where no potential problems were detected."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "NOT_ISSUE"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "This is similar to, but has different semantics to, bdqffdq:COMPLIANT for a bdqffdq:Validation. The value bdqffdq:COMPLIANT means that the data were evaluated as having quality according to a bdqffdq:Criterion. The value bdqffdq:NOT_ISSUE means that no bdqffdq:Issue with data quality was found under a bdqffdq:Criterion for identifying the absence of quality."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "NOT_ISSUE"
      }
    ]
  },
