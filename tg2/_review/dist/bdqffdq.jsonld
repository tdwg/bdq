  {
    "@id": "https://rs.tdwg.org/bdqffdq/",
    "@type": [
      "http://www.w3.org/2002/07/owl#Ontology"
    ],
    "http://purl.org/dc/terms/creator": [
      {
        "@value": "TDWG Biodiversity Data Quality Interest Group Task Group 2: Data Quality Tests and Assertions"
      }
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@language": "en",
        "@value": "The classes and object properties found in this ontology are dedicated to fundamental and derived concepts from the Fitness For Use Framework described in the paper by Veiga et al., available at: http://journals.plos.org/plosone/article?id=10.1371/journal.pone.0178731 as modified to describe data quality fitness for use Tests in the TDWG BDQ Standard."
      }
    ],
    "http://purl.org/dc/terms/hasPart": [
      {
        "@id": "https://rs.tdwg.org/bdqffdq/extension/"
      },
      {
        "@id": "https://rs.tdwg.org/bdqffdq/terms/"
      }
    ],
    "http://purl.org/dc/terms/issued": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-11-09"
      }
    ],
    "http://purl.org/dc/terms/license": [
      {
        "@id": "https://creativecommons.org/licenses/by/4.0/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Generated by rs.tdwg.org process/build_ontology.py from the term list https://rs.tdwg.org/bdqffdq/terms/ and the vocabulary extension term list https://rs.tdwg.org/bdqffdq/extension/. For OWL 2 DL, rdf:value is replaced by skos:notation (rs.tdwg.org uses rdf:value for controlled value strings, TDWG Standards Documentation Specification 4.5.4)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Biodiversity Data Quality Fitness for Use Framework (Ontology)"
      }
    ],
    "http://www.w3.org/2002/07/owl#versionIRI": [
      {
        "@id": "https://rs.tdwg.org/version/bdqffdq/2026-11-09"
      }
    ]
  },
  {
