        "@id": "https://rs.tdwg.org/bdqffdq/terms/NeedConcept"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "An aspect of data quality."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Describes the aspect of data quality (accuracy, precision, completeness, etc.) that a Test examines. For example, [precision] in [coordinate precision of Single Records]. In the original framework, only related to Measures, here may be related to any bdqffdq:DataQualityNeed."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Data Quality Dimension"
      }
    ]
  },
  {
    "@id": "https://rs.tdwg.org/bdqffdq/terms/DataQualityMethod",
