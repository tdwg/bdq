    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "IS_ISSUE"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A bdqffdq:ResponseResult of a bdqffdq:Issue indicating that the data do not have sufficient quality for a use."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "IS_ISSUE"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
